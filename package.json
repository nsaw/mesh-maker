{
  "name": "meshcraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && node -e \"for (const k of ['CLOUDFLARE_API_TOKEN','CLOUDFLARE_ACCOUNT_ID']) { if (!process.env[k]) { console.error(k + ' is required'); process.exit(1); } }\" && npx wrangler@4 pages deploy dist --project-name=meshcraft --branch=main --commit-dirty=true",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit",
    "lint": "eslint src/ cli/",
    "lint:fix": "eslint src/ cli/ --fix",
    "stl-to-sbp": "tsx cli/stl-to-sbp.ts",
    "test:relief-measurement": "tsx cli/relief-measurement.spec.ts",
    "test:relief-measurement-mutants": "python3 scripts/test-relief-measurement-mutants.py",
    "test:relief": "tsx cli/voronoi-relief.spec.ts",
    "test:relief-junction-mutants": "python3 scripts/test-relief-junction-mutants.py",
    "test:presets": "tsx cli/presets.spec.ts",
    "test:presets:geometry": "tsx cli/presets.spec.ts --geometry",
    "test:presets:export": "tsx cli/presets.spec.ts --export",
    "test:gh-parity": "tsx cli/grasshopper-parity.spec.ts",
    "test:gh-site-grid": "python3 scripts/test-gh-site-grid.py && python3 scripts/test-gh-rank-measurement.py",
    "test:drape": "tsx cli/drape.spec.ts",
    "test:drape-parity": "tsx cli/drape-parity.spec.ts",
    "test:depthmap": "tsx cli/depthmap.spec.ts",
    "drape-run": "tsx cli/drape-run.ts",
    "test:sbp-writer": "tsx cli/sbp-writer.spec.ts",
    "test:cut": "tsx cli/sbp-cut.spec.ts",
    "test:relief-master": "tsx cli/relief-master.spec.ts",
    "relief-roundtrip": "tsx cli/relief-roundtrip.ts",
    "preview": "vite preview",
    "prepare": "husky",
    "postbuild": "node scripts/check-asset-size.mjs dist",
    "test:noise-worker": "tsx cli/noise-worker.spec.ts",
    "test:relief-project": "tsx cli/relief-project.spec.ts",
    "test:relief-link": "tsx cli/relief-link.spec.ts",
    "test:relief-link-browser": "node scripts/ui/relief-links.spec.mjs",
    "test:noise-browser": "node scripts/test-noise-browser.mjs",
    "test:export-authority": "node scripts/test-export-authority.mjs",
    "test:render-geometry": "tsx cli/render-geometry.spec.ts",
    "test:ui-values": "node scripts/ui/values.spec.mjs",
    "test:ui-interruptions": "node scripts/ui/interruptions.spec.mjs",
    "test:generators": "tsx cli/generators.spec.ts",
    "test:generator-migration": "tsx cli/generator-migration.spec.ts",
    "test:cellular-hash-mutant": "python3 scripts/test-cellular-hash-mutant.py",
    "test:fit-frame": "tsx cli/fit-frame.spec.ts",
    "test:mobile-layout": "node scripts/ui/mobile-layout.spec.mjs",
    "test:relief-editor": "tsx cli/relief-editor.spec.ts",
    "test:relief-editor-transport": "node scripts/ui/relief-editor-transport.spec.mjs",
    "test:relief-editor-navigation": "node scripts/ui/relief-editor-navigation.spec.mjs",
    "test:relief-editor-browser": "node scripts/ui/relief-editor.spec.mjs",
    "test:cell-graph": "tsx cli/cell-graph.spec.ts",
    "test:cell-graph-warp": "tsx cli/cell-graph-warp.spec.ts",
    "test:cell-graph-bounds": "tsx cli/cell-graph-bounds.spec.ts",
    "test:cell-graph-worker": "tsx cli/cell-graph-worker.spec.ts",
    "test:relief-placement": "tsx cli/relief-placement.spec.ts",
    "test:generator-controls": "node scripts/ui/generators.spec.mjs",
    "test:relief-near-ties": "tsx cli/relief-near-ties.spec.ts",
    "test:relief-near-ties-mutants": "python3 scripts/test-relief-near-ties-mutants.py",
    "test:native-distance-consumers": "python3 scripts/test-native-distance-consumers.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.0.0",
    "@types/three": "^0.183.1",
    "better-sqlite3": "^12.8.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "playwright": "1.61.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "jolt-physics": "1.1.0",
    "three": "^0.183.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
